# Names only. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer current Supabase key types. Legacy variables below remain supported during migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CRON_SECRET=
# Legacy anon/service_role JWT keys (fallback only).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Recommended optional provider for rate limiting/report abuse protection.
RATE_LIMIT_PROVIDER_URL=
RATE_LIMIT_PROVIDER_TOKEN=
# Server-only AI and voice provider secrets. Never use NEXT_PUBLIC_ prefixes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Server-only fictional reporting gate. This grants simulated-unit reporting, not provider processing.
SIGNA_FICTIONAL_REPORTING_MODE=false
SIGNA_FICTIONAL_REPORTER_IDS=
# Separate Gemini gate: default off. Allowlist only controlled fictional reporter UUIDs.
# Set start time to the activation instant; older reports remain ineligible even if an account is later allowlisted.
# Remove IDs and delete fictional test records/evidence through the approved retention process after the demo.
SIGNA_FICTIONAL_TEST_MODE=false
SIGNA_FICTIONAL_TEST_REPORTER_IDS=
SIGNA_FICTIONAL_TEST_START_AT=
INTRON_API_KEY=
VOICEBIP_WEBHOOK_SECRET=
NEXT_PUBLIC_SIGNA_VOICE_ENABLED=false
